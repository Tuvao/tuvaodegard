---
import ProjectCard from "../components/ProjectCard.astro";
import Sparkle from "../components/Sparkle.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const traits = [
  "Curious",
  "Detail oriented",
  "Always learning something new",
];

---

<BaseLayout title="Tuva Ødegård — UX Designer & Frontend Developer">
  <section class="intro">
    <p class="intro-label">
      <Sparkle size="0.75em" />
      Front-end developer &amp; UX designer — Oslo
    </p>

    <h1>
      I bridge the gap between <span class="highlight">design</span> and{" "}
      <span class="squiggle-wrap">code<svg
          class="squiggle"
          viewBox="0 0 200 12"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        ><path
            d="M2 8c14-7 28 5 42-1s28-6 42 0 28 6 42 0 28-5 42 1"
            fill="none"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
          /></svg></span>.
    </h1>

    <p class="sticker">
      <Sparkle size="0.7em" /> Genuinely excited about good UX
    </p>

    <p class="intro-lead">
      I care about the full picture: understanding what users actually need,
      designing the interaction and bringing it to life through programming.
      I have a drive to make things that genuinely work well, with users in focus.
    </p>
    <p class="intro-bio">
      Beyond the technical, I believe great work comes from curiosity, people
      skills and always wanting to get better.
    </p>

    <ul class="traits">
      {traits.map((trait) => <li>{trait}</li>)}
    </ul>
  </section>

  <section id="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="projects-heading">Recent projects</h2>

    <ul class="project-list">
      {
        projects.map((project, i) => (
          <li class:list={[{ featured: i === 0 }]}>
            <ProjectCard project={project} featured={i === 0} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    position: relative;
    margin-bottom: 5.5rem;
  }

  .intro-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .intro-label :global(.sparkle) {
    color: var(--coral);
  }

  h1 {
    font-size: clamp(2.35rem, 7.5vw, 4.15rem);
    line-height: 1.05;
    max-width: 20ch;
    margin-bottom: 1.75rem;
  }

  /* Hand-drawn underline under the last word of the headline. */
  .squiggle-wrap {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .squiggle {
    position: absolute;
    left: 0;
    bottom: -0.16em;
    width: 100%;
    height: 0.24em;
    color: var(--coral);
    overflow: visible;
  }

  /* A slightly crooked sticker — the one deliberately imperfect thing. */
  .sticker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--coral-soft);
    color: var(--coral-ink);
    border: 2px solid var(--coral);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    transform: rotate(-2deg);
    margin: 0.5rem 0 2rem;
  }

  .sticker :global(.sparkle) {
    color: var(--coral);
  }

  .intro-lead {
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 58ch;
  }

  .intro-bio {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 58ch;
    margin-top: 1rem;
  }

  .traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 2rem;
  }

  .traits li {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .projects-heading {
    font-size: clamp(1.6rem, 4.5vw, 2.2rem);
    margin-bottom: 1.75rem;
  }

  .project-list {
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  /* Featured project spans the full row; the rest sit two-up. */
  @media (min-width: 52rem) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .project-list li.featured {
      grid-column: 1 / -1;
    }
  }
</style>
